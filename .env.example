DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Edmonton
DATABASE_URL=sqlite:///db.sqlite3
THREATBRIDGE_DATA_DIR=./data
THREATBRIDGE_ALLOWED_ADAPTER_PREFIXES=integrations.adapters.
THREATBRIDGE_ALLOWED_OUTBOUND_HOSTS=
THREATBRIDGE_ALLOWED_PRIVATE_OUTBOUND_CIDRS=
THREATBRIDGE_MAX_PAGES_PER_SYNC=50

# Secret references use env://PREFIX and resolve PREFIX_* variables.
# Example for secret_reference=env://DEFENDER:
# DEFENDER_TENANT_ID=
# DEFENDER_CLIENT_ID=
# DEFENDER_CLIENT_SECRET=
#
# Example for secret_reference=env://OPENCTI:
# OPENCTI_TOKEN=
THREATBRIDGE_MAX_UPLOAD_BYTES=52428800
THREATBRIDGE_MAX_IMPORT_RECORDS=100000
