# Copy to deploy/.env.production with scripts/prepare_production_deployment.py.
# Every image value must be an immutable repository digest, not a mutable tag.
# scripts/resolve_production_images.sh fills these in from publicly pullable tags;
# override THREATBRIDGE_BUILDER_TAG / THREATBRIDGE_RUNTIME_TAG to use another registry.
THREATBRIDGE_PYTHON_BUILDER_IMAGE=python@sha256:REPLACE_BUILDER_DIGEST
THREATBRIDGE_PYTHON_RUNTIME_IMAGE=python@sha256:REPLACE_RUNTIME_DIGEST
THREATBRIDGE_POSTGRES_IMAGE=postgres@sha256:REPLACE_POSTGRES_DIGEST
THREATBRIDGE_IMAGE=threatbridge:local

THREATBRIDGE_SECRETS_DIR=./deploy/secrets
# Loopback by default. Change this only to a specific host interface that your reverse
# proxy fronts; never use 0.0.0.0. See deploy/README.md.
THREATBRIDGE_BIND_ADDRESS=127.0.0.1
THREATBRIDGE_PORT=8020

DJANGO_ALLOWED_HOSTS=threatbridge.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://threatbridge.example.invalid
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TIME_ZONE=America/Edmonton

# Set true only when a reverse proxy terminates TLS AND unconditionally overwrites the
# X-Forwarded-Proto header AND clients cannot reach the published container port
# directly. Leaving this false is always safe.
THREATBRIDGE_TRUST_X_FORWARDED_PROTO=false

# Exact destinations only. Private destinations also require every resolved address
# to fit inside the explicitly approved private CIDR list.
THREATBRIDGE_ALLOWED_OUTBOUND_HOSTS=opencti.example.invalid
THREATBRIDGE_ALLOWED_PRIVATE_OUTBOUND_CIDRS=192.0.2.0/24
# Set true only when the optional Step CA overlay should be applied.
THREATBRIDGE_USE_EXTRA_CA=false
THREATBRIDGE_EXTRA_CA_PATH=./deploy/ca/internal-root-ca.crt

THREATBRIDGE_GUNICORN_WORKERS=3
THREATBRIDGE_GUNICORN_THREADS=2
THREATBRIDGE_GUNICORN_TIMEOUT=90
THREATBRIDGE_MAX_PAGES_PER_SYNC=50
THREATBRIDGE_MAX_HTTP_RESPONSE_BYTES=10485760
THREATBRIDGE_MAX_UPLOAD_BYTES=52428800
THREATBRIDGE_MAX_IMPORT_RECORDS=100000
THREATBRIDGE_OUTBOUND_CONNECT_TIMEOUT=10

# API rate limits applied by Django REST Framework.
THREATBRIDGE_ANON_THROTTLE_RATE=30/minute
THREATBRIDGE_USER_THROTTLE_RATE=600/minute

# Container resource ceilings honoured by docker compose.
THREATBRIDGE_APP_CPU_LIMIT=2.0
THREATBRIDGE_APP_MEMORY_LIMIT=1g
THREATBRIDGE_APP_MEMORY_RESERVATION=256m
THREATBRIDGE_DB_CPU_LIMIT=2.0
THREATBRIDGE_DB_MEMORY_LIMIT=1g
THREATBRIDGE_DB_MEMORY_RESERVATION=256m
